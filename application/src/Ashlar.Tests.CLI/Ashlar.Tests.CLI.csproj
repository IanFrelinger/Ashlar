<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../src/Ashlar.Tests.Infrastructure/Helpers/EgressProcessStateScope.cs" Link="Helpers/EgressProcessStateScope.cs" />
    <Compile Include="../../../src/Ashlar.Tests.Infrastructure/Helpers/EnvironmentVariableScope.cs" Link="Helpers/EnvironmentVariableScope.cs" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Ashlar.Abstractions/Ashlar.Abstractions.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Core.Application/Ashlar.Core.Application.csproj" />
    <ProjectReference Include="..\Ashlar.CLI\Ashlar.CLI.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Infrastructure/Ashlar.Infrastructure.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Sdk/Ashlar.Sdk.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Framework.Sdk/Ashlar.Framework.Sdk.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Authoring/Ashlar.Authoring.csproj" />
    <!-- TestHelpers (AgentCommandTests, AnalyzeCommandTests) used to arrive through the CLI's
         test-project references, which are now opt-in. -->
    <ProjectReference Include="../../../src/Ashlar.Tests.Application/Ashlar.Tests.Application.csproj" />
  </ItemGroup>

  <!-- Without this the file never reaches bin\ and xunit reads whatever stale copy
       is already there — which is exactly how collection parallelism stayed on
       despite the json saying otherwise. Matches Ashlar.Tests.Application. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
