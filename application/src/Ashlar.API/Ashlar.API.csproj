<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0 ONLY. The Dockerfiles publish -f net10.0 and the API uses the net10.0 runtime.
         This is single-target on purpose: an earlier comment here described a net8.0;net10.0
         multi-target that does not exist, which masked the root cause of an NU1201 that broke
         Ashlar.sln — any project that references this one MUST target net10.0. The commercial
         hosts (GameDirector.Host, Fleet.Api, Fleet.Host) were bumped to net10.0 for exactly this
         reason. Ashlar.Tests.Infrastructure multi-targets net8.0;net10.0 but references this
         project only on its net10.0 leg (see its .csproj), which is why the net8.0 cert-gate
         build is unaffected. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.API</PackageId>
    <Title>Ashlar API</Title>
    <Description>HTTP API for Ashlar kernel. Exposes agent, validate, improve, observe, and execution endpoints.</Description>
    <PackageTags>ashlar;ai;api;orchestration</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Ashlar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <!-- Local GGUF inference opt-in. Ashlar.Infrastructure marks this backend PrivateAssets=all so
         that no consumer inherits its four colliding CPU-variant native sets, which means every
         deployable host that wants LocalModelProvider (the "local" provider, gated on
         ASHLAR_LOCAL_MODEL_PATH) has to re-add it. Dropping this line is a silent capability
         loss, not a build error: "local" just reports unavailable. The API Dockerfiles publish
         without -r, so the four variants keep their own runtimes/<rid>/native/<variant>/ folders;
         a RID publish needs the variant prune documented in consumer-template/CONSUMING.md.
         This reference stays PUBLIC, deliberately, and that is a trade-off rather than an
         oversight. This project is IsPackable=true with PackageId Ashlar.API, so the packed
         nuspec re-declares the backend and anyone who ever restored an Ashlar.API package would
         inherit the four colliding variants and hit NETSDK1152 on their own RID publish - the
         defect this release fixes, surviving one package over. PrivateAssets=all is not the way
         out: measured in the devtest container, it removes the natives from THIS project's own
         RID-less publish too (84 backend native files to 0 with nothing else changed), which is
         exactly the capability the shipped API images are promised to keep. The leak is bounded
         instead: no release workflow packs Ashlar.API (reusable-release-nuget.yml packs the
         hosting graph, Client, Sdk, Authoring and the CLI tool), so no such package exists on a
         feed, and the A2A note below already says this project is not pack-ready. If Ashlar.API
         is ever put on a feed, the backend has to move behind a separate opt-in package or the
         API has to stop being packable - it cannot be solved on this line. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- OTLP export (traces + metrics), active only when OTEL_EXPORTER_OTLP_ENDPOINT is set. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="../../../src/Ashlar.BackgroundAgents.HostRunners/Ashlar.BackgroundAgents.HostRunners.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Brick.Contracts/Ashlar.Brick.Contracts.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Contracts/Ashlar.Contracts.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Hosting/Ashlar.Hosting.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Ingress.DynamoDb/Ashlar.Ingress.DynamoDb.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Ingress.AwsSns/Ashlar.Ingress.AwsSns.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Infrastructure/Ashlar.Infrastructure.csproj" />
    <!-- Agent-protocol adapters (feature-flagged off by default). Note: the A2A projects are
         IsPackable=false while the A2A SDK is prerelease; Ashlar.API is not packed by any release
         workflow today, but if it ever is, these references must be revisited (NU5104). -->
    <ProjectReference Include="../../../src/Ashlar.Mcp.Server/Ashlar.Mcp.Server.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Mcp.Client/Ashlar.Mcp.Client.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Transport.A2A/Ashlar.Transport.A2A.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Transport.A2A.Server/Ashlar.Transport.A2A.Server.csproj" />
  </ItemGroup>

</Project>
