<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AshlarCommercialProject>true</AshlarCommercialProject>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- ASHLAREXP002: this assembly consumes the experimental security and deployment-profile surface of
       Ashlar.Abstractions by design (docs/SdkCompatibilityPolicy.md#ashlarexp002). Reviewed in
       DiagnosticSuppressionConventionTests (ReviewedProjectWideDisables), which also fails this opt-in
       once no file of this project uses that surface. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);ASHLAREXP002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ashlar.Commercial.Tests.MeshDirector" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPEC-007: the director client is built by EgressHttp (Ashlar.Abstractions), so its requests reach the egress guard. -->
    <ProjectReference Include="../../../src/Ashlar.Abstractions/Ashlar.Abstractions.csproj" />
  </ItemGroup>
</Project>
