<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;RS0036;RS0037</NoWarn>
    <PackageId>Ashlar.Authoring</PackageId>
    <Title>Ashlar Authoring</Title>
    <Description>Minimal package for code-authored Ashlar bricks: Brick base types, execution contracts, and host registration helpers. It does not bring the host: a host that calls AddAshlar() references Ashlar.Hosting.Bundle.</Description>
    <PackageTags>ashlar;authoring;bricks;sdk</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Ashlar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Brick.Contracts\Ashlar.Brick.Contracts.csproj" />
    <ProjectReference Include="..\Ashlar.Core.Domain\Ashlar.Core.Domain.csproj" />
    <ProjectReference Include="..\Ashlar.Core.Application\Ashlar.Core.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
