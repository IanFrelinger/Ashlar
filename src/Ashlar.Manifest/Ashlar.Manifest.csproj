<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0;net10.0 rather than the netstandard2.0 the other contracts projects carry.
         Nothing consumes the manifest from a netstandard2.0 host: it is read by the CLI,
         the Studio backend, and the runtime gate, all of which are modern .NET. Staying off
         netstandard2.0 keeps System.Index/System.Range available. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.Manifest</PackageId>
    <Title>Ashlar Manifest</Title>
    <Description>The ashlar.yaml project contract and the operator-owned ashlar.policy.yaml envelope, with fail-closed loaders that keep the two apart.</Description>
    <PackageTags>ashlar;manifest;policy;agents</PackageTags>
  </PropertyGroup>

  <!-- ASHLAREXP002: this assembly consumes the experimental security and deployment-profile surface of
       Ashlar.Abstractions by design (docs/SdkCompatibilityPolicy.md#ashlarexp002). Reviewed in
       DiagnosticSuppressionConventionTests (ReviewedProjectWideDisables), which also fails this opt-in
       once no file of this project uses that surface. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);ASHLAREXP002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="NSec.Cryptography" />
  </ItemGroup>

</Project>
