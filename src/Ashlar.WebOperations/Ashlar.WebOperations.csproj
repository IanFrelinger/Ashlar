<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Not packed yet: the bundled job specs have been exercised only against recorded response shapes here. -->
        <IsPackable>false</IsPackable>
        <Description>Web operations for Ashlar: a website's own data requests as declared, versioned operations that bricks call over plain HTTP behind the egress guard, with classified results, learning from captured requests, self-repair when a response moves, and guarded writes. Bundles employer job-board operations.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ashlar.Core.Domain\Ashlar.Core.Domain.csproj" />
        <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Specs\Bundled\*.json" LogicalName="Ashlar.WebOperations.Specs.%(Filename).json" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ashlar.Analyzers\Ashlar.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          UndefineProperties="TargetFramework" />
    </ItemGroup>

</Project>
