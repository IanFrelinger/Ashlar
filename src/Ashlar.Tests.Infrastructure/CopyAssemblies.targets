<Project>
  <!-- Automatically copy all assemblies from deps.json that the test host can't find -->
  <!-- This is a workaround for .NET 8.0 test host issue with finding assemblies from NuGet cache -->
  <Target Name="CopyAllRequiredAssemblies" AfterTargets="Build">
    <PropertyGroup>
      <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages</NuGetPackageRoot>
      <NuGetPackageRoot Condition="'$(OS)' != 'Windows_NT' AND '$(NuGetPackageRoot)' == ''">$(HOME)/.nuget/packages</NuGetPackageRoot>
      <NormalizedOutputPath>$([System.IO.Path]::GetFullPath('$(OutputPath)'))</NormalizedOutputPath>
      <NormalizedOutputPath Condition="$([System.String]::Copy('$(NormalizedOutputPath)').EndsWith('\'))">$([System.String]::Copy('$(NormalizedOutputPath)').TrimEnd('\'))</NormalizedOutputPath>
      <DepsJsonPath>$(OutputPath)$(AssemblyName).deps.json</DepsJsonPath>
      <CopyScriptDir>$(MSBuildThisFileDirectory)scripts</CopyScriptDir>
      <CopyScriptProj>$(CopyScriptDir)\copy-assemblies.csproj</CopyScriptProj>
      <CopyScriptProj Condition="'$(OS)' != 'Windows_NT'">$(CopyScriptDir)/copy-assemblies.csproj</CopyScriptProj>
      <!-- Always net10.0 — see scripts/copy-assemblies.csproj (avoids NETSDK1005 when the parent inner build is another TFM). -->
      <CopyAssemblyToolTfm>net10.0</CopyAssemblyToolTfm>
      <CopyScriptExe>$(CopyScriptDir)\bin\Debug\$(CopyAssemblyToolTfm)\copy-assemblies.dll</CopyScriptExe>
      <CopyScriptExe Condition="'$(OS)' != 'Windows_NT'">$(CopyScriptDir)/bin/Debug/$(CopyAssemblyToolTfm)/copy-assemblies.dll</CopyScriptExe>
    </PropertyGroup>
    
    <!-- Build the C# assembly copying tool (always net10.0; runs under the pinned SDK 10). -->
    <MSBuild Projects="$(CopyScriptProj)" 
             Targets="Restore;Build" 
             Properties="Configuration=Debug;TargetFramework=$(CopyAssemblyToolTfm)"
             Condition="Exists('$(CopyScriptProj)') AND '$(SkipCopyAssemblies)' != 'true'"
             ContinueOnError="false" />
    
    <!-- Use C# program to copy all assemblies from deps.json (including Avalonia, Castle.Core, etc.) -->
    <Exec Command="dotnet &quot;$(CopyScriptExe)&quot; &quot;$(DepsJsonPath)&quot; &quot;$(NormalizedOutputPath)&quot; &quot;$(NuGetPackageRoot)&quot;" 
          Condition="Exists('$(CopyScriptExe)') AND Exists('$(DepsJsonPath)') AND '$(SkipCopyAssemblies)' != 'true'"
          ContinueOnError="true" />
    
    <!-- Alternative: Use dotnet run if the DLL doesn't exist yet (builds on first run) -->
    <Exec Command="dotnet run --project &quot;$(CopyScriptProj)&quot; -f $(CopyAssemblyToolTfm) -- &quot;$(DepsJsonPath)&quot; &quot;$(NormalizedOutputPath)&quot; &quot;$(NuGetPackageRoot)&quot;" 
          Condition="!Exists('$(CopyScriptExe)') AND Exists('$(CopyScriptProj)') AND Exists('$(DepsJsonPath)') AND '$(SkipCopyAssemblies)' != 'true'"
          ContinueOnError="true" />
    
    <!-- Docker.DotNet must retain the runtime asset selected by deps.json above. Its netstandard
         fallback has a different CreateClient signature and must not overwrite the selected assembly. -->
    <!-- Fallback: Known problematic assemblies that need to be copied -->
    <!-- These are assemblies that target net6.0, netstandard2.x, net7.0, or netcoreapp3.1 -->
    <ItemGroup>
      <AssembliesToCopy Include="$(NuGetPackageRoot)/castle.core/5.2.1/lib/net6.0/Castle.Core.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\castle.core\5.2.1\lib\net6.0\Castle.Core.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/fluentassertions/8.10.0/lib/net6.0/FluentAssertions.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\fluentassertions\8.10.0\lib\net6.0\FluentAssertions.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/fluentvalidation/11.9.2/lib/net8.0/FluentValidation.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\fluentvalidation\11.9.2\lib\net8.0\FluentValidation.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/fluentvalidation.dependencyinjectionextensions/11.9.2/lib/netstandard2.1/FluentValidation.DependencyInjectionExtensions.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\fluentvalidation.dependencyinjectionextensions\11.9.2\lib\netstandard2.1\FluentValidation.DependencyInjectionExtensions.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/icsharpcode.decompiler/8.0.0.7345/lib/netstandard2.0/ICSharpCode.Decompiler.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\icsharpcode.decompiler\8.0.0.7345\lib\netstandard2.0\ICSharpCode.Decompiler.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/jetbrains.annotations/2025.2.0/lib/netstandard2.0/JetBrains.Annotations.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\jetbrains.annotations\2025.2.0\lib\netstandard2.0\JetBrains.Annotations.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/json.more.net/1.7.0/lib/netstandard2.0/Json.More.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\json.more.net\1.7.0\lib\netstandard2.0\Json.More.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/jsonpointer.net/3.0.0/lib/netstandard2.0/JsonPointer.Net.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\jsonpointer.net\3.0.0\lib\netstandard2.0\JsonPointer.Net.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/jsonschema.net/4.0.0/lib/netstandard2.0/JsonSchema.Net.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\jsonschema.net\4.0.0\lib\netstandard2.0\JsonSchema.Net.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/mediatr/12.4.1/lib/net6.0/MediatR.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\mediatr\12.4.1\lib\net6.0\MediatR.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/mediatr.contracts/2.0.1/lib/netstandard2.0/MediatR.Contracts.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\mediatr.contracts\2.0.1\lib\netstandard2.0\MediatR.Contracts.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/microsoft.bcl.asyncinterfaces/6.0.0/lib/netstandard2.1/Microsoft.Bcl.AsyncInterfaces.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\microsoft.bcl.asyncinterfaces\6.0.0\lib\netstandard2.1\Microsoft.Bcl.AsyncInterfaces.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/microsoft.codeanalysis.common/4.8.0/lib/net7.0/Microsoft.CodeAnalysis.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\microsoft.codeanalysis.common\4.8.0\lib\net7.0\Microsoft.CodeAnalysis.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/microsoft.codeanalysis.csharp/4.8.0/lib/net7.0/Microsoft.CodeAnalysis.CSharp.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\microsoft.codeanalysis.csharp\4.8.0\lib\net7.0\Microsoft.CodeAnalysis.CSharp.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/microsoft.codecoverage/17.8.0/lib/netcoreapp3.1/Microsoft.VisualStudio.CodeCoverage.Shim.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\microsoft.codecoverage\17.8.0\lib\netcoreapp3.1\Microsoft.VisualStudio.CodeCoverage.Shim.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)/microsoft.playwright/1.48.0/lib/netstandard2.0/Microsoft.Playwright.dll" Condition="'$(OS)' != 'Windows_NT'" />
      <AssembliesToCopy Include="$(NuGetPackageRoot)\microsoft.playwright\1.48.0\lib\netstandard2.0\Microsoft.Playwright.dll" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    
    <Message Text="Copying assemblies to $(OutputPath)" Importance="high" Condition="'$(SkipCopyAssemblies)' != 'true'" />
    <Copy SourceFiles="@(AssembliesToCopy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(Identity)') AND '$(SkipCopyAssemblies)' != 'true'" />
  </Target>
</Project>
