<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.Certification.Contracts</PackageId>
    <Title>Ashlar Certification Contracts</Title>
    <Description>Content-bound certification record verification for external brick consumers.</Description>
    <PackageTags>ashlar;certification;bricks;trust</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The canonical-payload shape guard is exercised directly against payloads this process
         cannot make the serializer emit; the publish modes that produce them are not
         reproducible inside a test host. -->
    <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- Ed25519 dual-write signing; NSec has no netstandard2.0 target, so those
         consumers verify HMAC-only records and refuse any record carrying an Ed25519
         signature they cannot evaluate (see CertificationRecordEd25519). -->
    <PackageReference Include="NSec.Cryptography" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
  </ItemGroup>

</Project>
