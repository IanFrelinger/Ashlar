<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <PackageId>Ashlar.Bricks.GitHub</PackageId>
        <Title>Ashlar GitHub Bricks</Title>
        <Description>GitHub operations bricks for Ashlar: what is blocking a pull request or release (with evidence links and explicit unknowns), pull request status and CI status for a ref, built on Octokit behind the Ashlar egress guard.</Description>
        <PackageTags>ashlar;bricks;github;pull-requests;releases;ci</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ashlar.Core.Domain\Ashlar.Core.Domain.csproj" />
        <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Octokit" />
    </ItemGroup>

    <!-- The package page shows this project's README, not the repository README every other
         packable project inherits from Directory.Build.props. -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Brick contract drift rule (ASHLAR0001/ASHLAR0002): keeps BrickInterface and the
         Get/Set keys a brick actually uses from silently diverging. PrivateAssets keeps the
         analyzer a build-time rule of this repository rather than a package dependency. -->
    <ItemGroup>
        <ProjectReference Include="..\Ashlar.Analyzers\Ashlar.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          UndefineProperties="TargetFramework" />
    </ItemGroup>

</Project>
