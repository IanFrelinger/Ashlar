<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Three ITool implementations for an Ashlar kernel that inspect .NET assemblies: assembly.analyze reads metadata, assembly.decompile emits C# source, assembly.security_scan flags dangerous API calls.</Description>
    <PackageTags>ashlar tools assembly decompiler security-scan</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Mono.Cecil" />
    <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
  </ItemGroup>
</Project>
