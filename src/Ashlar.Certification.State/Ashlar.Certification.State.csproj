<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.Certification.State</PackageId>
    <Title>Ashlar Certification State</Title>
    <Description>Attested state log binding: schema-bound mutable state with certified transition provenance.</Description>
    <PackageTags>ashlar;certification;state;trust</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The canonical entry-hash payload is pinned byte-for-byte by
         CertifiedTransitionEntryHashGoldenTests; the public API exposes only the hash of it. -->
    <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Certification.Contracts\Ashlar.Certification.Contracts.csproj" />
  </ItemGroup>

</Project>
