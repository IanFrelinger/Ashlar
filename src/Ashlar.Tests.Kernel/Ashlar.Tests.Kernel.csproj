<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
    <ProjectReference Include="..\Ashlar.Brick.Contracts\Ashlar.Brick.Contracts.csproj" />
    <ProjectReference Include="..\Ashlar.Manifest\Ashlar.Manifest.csproj" />
    <ProjectReference Include="..\Ashlar.Policies\Ashlar.Policies.csproj" />
    <ProjectReference Include="..\Ashlar.Policies.Dev\Ashlar.Policies.Dev.csproj" />
    <ProjectReference Include="..\Ashlar.Tools.Assembly\Ashlar.Tools.Assembly.csproj" />
    <ProjectReference Include="..\Ashlar.Tools.Dev\Ashlar.Tools.Dev.csproj" />
  </ItemGroup>

  <!-- The runtime switch is read at process startup, so these regressions use a tiny child host. -->
  <ItemGroup>
    <ProjectReference Include="../../tools/InputSafetyProbe/InputSafetyProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyInputSafetyProbe" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <!-- Literal output roots keep the readiness build-input lens auditable. -->
      <InputSafetyProbeFiles Include="../../tools/InputSafetyProbe/bin/Debug/net8.0/**/*" Condition="'$(Configuration)|$(TargetFramework)' == 'Debug|net8.0'" />
      <InputSafetyProbeFiles Include="../../tools/InputSafetyProbe/bin/Debug/net10.0/**/*" Condition="'$(Configuration)|$(TargetFramework)' == 'Debug|net10.0'" />
      <InputSafetyProbeFiles Include="../../tools/InputSafetyProbe/bin/Release/net8.0/**/*" Condition="'$(Configuration)|$(TargetFramework)' == 'Release|net8.0'" />
      <InputSafetyProbeFiles Include="../../tools/InputSafetyProbe/bin/Release/net10.0/**/*" Condition="'$(Configuration)|$(TargetFramework)' == 'Release|net10.0'" />
    </ItemGroup>
    <Copy SourceFiles="@(InputSafetyProbeFiles)"
          DestinationFiles="@(InputSafetyProbeFiles->'$(OutDir)InputSafetyProbe/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
