<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Default implementations behind Ashlar's application ports: CertificationGate with its mutation and witness runners, signed certification record stores, LLM provider factories, and their DI extensions. The certified-brick hot-swap host lives here too, behind the experimental ASHLAREXP001 opt-in.</Description>
    <PackageTags>ashlar certification hot-swap adapters infrastructure</PackageTags>
  </PropertyGroup>


    <ItemGroup>
        <!-- UnitTestFrameworkBridge is internal (it compiles against xunit, which this package does
             NOT ship), and the four test assemblies that drive it each need to see it. -->
        <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
        <InternalsVisibleTo Include="Ashlar.Tests.Application" />
        <InternalsVisibleTo Include="Ashlar.Tests.Domain" />
        <InternalsVisibleTo Include="Ashlar.Tests.CLI" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors />
    </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Execution/Templates/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Certification.Contracts\Ashlar.Certification.Contracts.csproj" />
    <ProjectReference Include="..\Ashlar.Brick.Contracts\Ashlar.Brick.Contracts.csproj" />
    <ProjectReference Include="..\Ashlar.Core.Application\Ashlar.Core.Application.csproj" />
    <ProjectReference Include="..\Ashlar.Core.Domain\Ashlar.Core.Domain.csproj" />
        <ProjectReference Include="..\Ashlar.Policies\Ashlar.Policies.csproj" />
        <ProjectReference Include="..\Ashlar.Runtime\Ashlar.Runtime.csproj" />
        <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Execution/Templates/UiDomainKnowledgeRetentionTests.template.cs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.AI.Abstractions" VersionOverride="10.10.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Docker.DotNet.Enhanced" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Mono.Cecil" />
        <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="LiteDB" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Force patched native SQLite bundle (GHSA-2m69-gcr7-jv3q); overrides transitive lib.e_sqlite3 2.1.6. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Polly" />
    <PackageReference Include="OsmSharp" />
    <PackageReference Include="LlamaSharp" />
    <!-- PrivateAssets: the backend ships four same-named CPU-variant native sets (avx, avx2,
         avx512, noavx) under a single runtimes/<rid>/native tree. A RID publish flattens that
         tree, so every consumer of this package failed `dotnet publish -r <rid>` with NETSDK1152
         on 20 colliding files. PrivateAssets is the only knob that changes the PACKED dependency
         list, and that list is the only thing a third party restoring from a feed can see — a
         Condition here would be evaluated at pack time and be invisible to them. The managed
         LlamaSharp package above is what the C# compiles against; this one contributes natives
         only, so nothing fails to build without it. Local GGUF inference is therefore opt-in per
         deployable host (application/src/Ashlar.API, application/src/Ashlar.CLI, and the snippet
         in consumer-template/CONSUMING.md for third parties). -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" PrivateAssets="all" />
    <PackageReference Include="xunit">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Brick contract drift rule (ASHLAR0001/ASHLAR0002): keeps BrickInterface and the
       Get/Set keys a brick actually uses from silently diverging. -->
  <ItemGroup>
    <!-- ReferenceOutputAssembly=true (not the usual false): AnalyzerFenceGate attaches this
         same catalog to candidate compilations in the certification chain (spec A1.2), so the
         assembly is a library dependency here in addition to running as an analyzer.
         UndefineProperties: hosts build with a global -p:TargetFramework (e.g. the CLI
         image); the analyzer project is netstandard2.0-only, so that global must not leak
         into its evaluation — nearest-TF negotiation picks the ns2.0 output. -->
    <ProjectReference Include="..\Ashlar.Analyzers\Ashlar.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

</Project>

