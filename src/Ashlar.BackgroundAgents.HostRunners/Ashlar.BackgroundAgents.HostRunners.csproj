<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ASHLAREXP002: this assembly consumes the experimental security and deployment-profile surface of
       Ashlar.Abstractions by design (docs/SdkCompatibilityPolicy.md#ashlarexp002). Reviewed in
       DiagnosticSuppressionConventionTests (ReviewedProjectWideDisables), which also fails this opt-in
       once no file of this project uses that surface. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);ASHLAREXP002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
    <ProjectReference Include="..\Ashlar.BackgroundAgents\Ashlar.BackgroundAgents.csproj" />
    <ProjectReference Include="..\Ashlar.Core.Application\Ashlar.Core.Application.csproj" />
    <ProjectReference Include="..\Ashlar.Manifest\Ashlar.Manifest.csproj" />
    <ProjectReference Include="..\Ashlar.Policies.Dev\Ashlar.Policies.Dev.csproj" />
    <ProjectReference Include="..\Ashlar.Runtime\Ashlar.Runtime.csproj" />
    <ProjectReference Include="..\Ashlar.Tools.Dev\Ashlar.Tools.Dev.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
