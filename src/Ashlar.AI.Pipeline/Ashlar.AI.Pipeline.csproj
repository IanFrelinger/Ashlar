<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.AI.Pipeline</PackageId>
    <Title>Ashlar AI Pipeline</Title>
    <Description>Microsoft.Extensions.AI governed chat pipeline for Ashlar (local Ollama, local LLamaSharp/ONNX-key target, and future cloud targets).</Description>
    <PackageTags>ashlar;ai;meai;ichatclient;ollama;llamasharp;bedrock</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Ashlar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Abstractions\Ashlar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="LlamaSharp" />
    <!-- PrivateAssets for the same reason as Ashlar.Infrastructure: the backend's four
         CPU-variant native sets collide on a consumer's RID publish (NETSDK1152), and only
         the packed dependency list is visible to a consumer restoring from a feed. The
         LlamaSharpChatClient compiles against managed LlamaSharp alone and loads natives
         lazily, so a host with no backend still registers the local:onnx keyed target and
         simply never reaches it. Hosts that want it opt in with their own PackageReference. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" PrivateAssets="all" />
    <PackageReference Include="AWSSDK.BedrockRuntime" />
    <PackageReference Include="AWSSDK.Extensions.Bedrock.MEAI" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
  </ItemGroup>

</Project>
