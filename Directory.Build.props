<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Pin C# 12 across all TFMs. From net9.0 onward (C# 13 with SDK 9, C# 14 with SDK 10) the compiler
         honors OverloadResolutionPriority, which mis-binds FluentAssertions 8's object.Should() to the
         Should<TEnum> enum overload (CS0453). The pin is a language-version pin, so it stays valid on SDK 10. -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SDK 10 prunes framework-provided packages from the net10.0 graph and raises NU1510 for a
         DIRECT reference that would be prunable. The audit overrides below and the 10.0.x central pins
         (System.Text.Json, Microsoft.Extensions.*) are exactly such references, and whether they are
         "prunable" flips with the runtime patch bundled in whichever 10.0.x SDK is installed
         (10.0.11 vs the SDK's 10.0.10 framework, for example). Suppress the hint instead of chasing it
         per SDK release; pruning itself stays on. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <RepositoryUrl>https://github.com/IanFrelinger/Ashlar</RepositoryUrl>
    <!-- Package author/provenance. Without these, `dotnet pack` writes the assembly id into
         <authors> (e.g. authors=Ashlar.Sdk), which reads as broken provenance on a public
         feed. Set once here so all packable projects inherit it. MAINTAINER: confirm the
         author/company/copyright string is how you want it to appear on nuget.org. -->
    <Authors>Ian Frelinger</Authors>
    <Company>Ian Frelinger</Company>
    <Copyright>Copyright (c) Ian Frelinger</Copyright>
    <!-- Open packable projects resolve Apache-2.0 via Directory.Build.targets; commercial clears the expression. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/IanFrelinger/Ashlar</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon Condition="Exists('$(MSBuildThisFileDirectory)assets/brand/ashlar-icon-nuget-128.png')">icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Canonical package version source: root VERSION file (scripts/resolve-canonical-package-version.sh). -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)VERSION')">
    <AshlarPackageVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</AshlarPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Override transitive System.Text.Encodings.Web 4.5.x (NU1904 / GHSA-ghhp-997w-qr28). -->
  <!-- Override transitive System.Text.RegularExpressions 4.3.0 (NU1903 / GHSA-cmhx-cq75-c4mj). -->
  <!-- Skip for package-only SDK sample: uses explicit versions + local Directory.Packages.props (see docs/samples/.../package-consumer). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'StableSdkHostSample.Package' AND '$(MSBuildProjectName)' != 'Ashlar.Hosting.Bundle' AND '$(MSBuildProjectName)' != 'Ashlar.Runtime.Bundle' AND '$(MSBuildProjectName)' != 'Ashlar.NugetOrgRestoreVerify' AND '$(MSBuildProjectName)' != 'Ashlar.NugetOrgRestoreHostingOnly' AND '$(MSBuildProjectName)' != 'Ashlar.Brick.Contracts'">
    <PackageReference Include="System.Text.Encodings.Web" />
    <PackageReference Include="System.Text.RegularExpressions" />
  </ItemGroup>

  <!-- NuGet pack: README at repo root (NU5039 if only PackageReadmeFile without packed file). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' AND '$(MSBuildProjectName)' != 'Ashlar.Hosting.Bundle' AND '$(MSBuildProjectName)' != 'Ashlar.Runtime.Bundle' AND '$(MSBuildProjectName)' != 'Ashlar.Bricks.GitHub'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- NuGet pack: brand icon from assets/brand (NU5046 if only PackageIcon without packed file).
       No bundle exclusion here, unlike README above: the bundles pack their OWN README.md, but
       no project packs its own icon, so every packable project takes this one. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' AND Exists('$(MSBuildThisFileDirectory)assets/brand/ashlar-icon-nuget-128.png')">
    <None Include="$(MSBuildThisFileDirectory)assets/brand/ashlar-icon-nuget-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>