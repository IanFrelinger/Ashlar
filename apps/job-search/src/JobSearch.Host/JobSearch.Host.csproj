<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>jobsearch</AssemblyName>
    <RootNamespace>JobSearch.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobSearch.Core\JobSearch.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\Ashlar.Hosting\Ashlar.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\src\Ashlar.Authoring\Ashlar.Authoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- jobsearch serve: the studio's web host. A framework reference, not the Web SDK, so the CLI stays one project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Anthropic" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <!-- The certified bricks as deployed: record, the source it covers, the gate-emitted assembly, and the pinned signer
         key. CertifiedBricks verifies all of it at start-up; the witnesses and csproj files are the certifier's, not the app's. -->
    <None Include="..\..\certified\**\certification.json;..\..\certified\**\*.cs;..\..\certified\**\gate-emitted-brick.dll;..\..\certified\trusted-signer.ed25519.pub"
          LinkBase="certified" CopyToOutputDirectory="PreserveNewest" />
    <!-- Starter steps the platform certifies on first start, and the designer UI (self-contained: no CDN). -->
    <None Include="..\..\library-seeds\*.json" LinkBase="library-seeds" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\studio-ui\**\*" LinkBase="studio-ui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
