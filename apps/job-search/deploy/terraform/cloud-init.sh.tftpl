#!/bin/bash
# First boot of the Job Search Studio server, generated by Terraform (deploy/terraform/main.tf). It holds no secrets:
# the studio reads them from the parameter store each time it starts (/opt/jobsearch/bin/jobsearch env).
set -euo pipefail
exec >>/var/log/jobsearch-init.log 2>&1
echo "jobsearch init: $(date -u)"

# The data volume holds the database, the step library, the model weights and the certificates. It is formatted on
# first use only, so a replaced instance mounts the same data.
dev=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_serial}
for _ in $(seq 1 120); do
  [ -e "$dev" ] && break
  sleep 5
done
[ -e "$dev" ] || { echo "the data volume never appeared at $dev"; exit 1; }
blkid "$dev" >/dev/null 2>&1 || mkfs.ext4 -q -L jobsearch-data "$dev"
uuid=$(blkid -s UUID -o value "$dev")
mkdir -p /srv/jobsearch
grep -q "$uuid" /etc/fstab || echo "UUID=$uuid /srv/jobsearch ext4 defaults,noatime,nofail 0 2" >>/etc/fstab
mountpoint -q /srv/jobsearch || mount /srv/jobsearch
mkdir -p /srv/jobsearch/data /srv/jobsearch/ollama /srv/jobsearch/caddy
chown 1654:1654 /srv/jobsearch/data # the studio image's unprivileged 'app' user
chmod 700 /srv/jobsearch/data /srv/jobsearch/ollama /srv/jobsearch/caddy

# Docker and Compose from Ubuntu's signed packages; the AWS CLI from its publisher's snap.
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
apt-get install -y -q docker.io docker-compose-v2
snap list aws-cli >/dev/null 2>&1 || snap install aws-cli --classic
install -d -m 755 /etc/docker
cat >/etc/docker/daemon.json <<'JOBSEARCH_FILE'
{ "live-restore": true, "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "3" } }
JOBSEARCH_FILE
systemctl enable docker
systemctl restart docker

install -d -m 755 /opt/jobsearch /opt/jobsearch/bin
cat >/opt/jobsearch/bin/jobsearch <<'JOBSEARCH_FILE'
${host_script}
JOBSEARCH_FILE
chmod 755 /opt/jobsearch/bin/jobsearch
cat >/opt/jobsearch/docker-compose.yml <<'JOBSEARCH_FILE'
${compose_file}
JOBSEARCH_FILE
cat >/opt/jobsearch/Caddyfile <<'JOBSEARCH_FILE'
${caddyfile}
JOBSEARCH_FILE
cat >/opt/jobsearch/host.conf <<'JOBSEARCH_FILE'
AWS_REGION=${region}
PARAM_PATH=${param_path}
BACKUP_BUCKET=${bucket}
ECR_REGISTRY=${ecr_registry}
STUDIO_REPOSITORY=${repository}
JOBSEARCH_FILE
cat >/opt/jobsearch/.env <<'JOBSEARCH_FILE'
STUDIO_IMAGE=${initial_image}
STUDIO_DOMAIN=${domain}
ACME_EMAIL=${acme_email}
PRIVATE_MODEL=${private_model}
JOBSEARCH_FILE
chmod 644 /opt/jobsearch/host.conf /opt/jobsearch/.env /opt/jobsearch/docker-compose.yml /opt/jobsearch/Caddyfile

cat >/etc/systemd/system/jobsearch.service <<'JOBSEARCH_FILE'
${unit_studio}
JOBSEARCH_FILE
cat >/etc/systemd/system/jobsearch-backup.service <<'JOBSEARCH_FILE'
${unit_backup}
JOBSEARCH_FILE
cat >/etc/systemd/system/jobsearch-backup.timer <<'JOBSEARCH_FILE'
${unit_backup_timer}
JOBSEARCH_FILE
systemctl daemon-reload
systemctl enable jobsearch.service jobsearch-backup.timer
systemctl start jobsearch-backup.timer
systemctl start jobsearch.service
echo "jobsearch init done: $(date -u)"
