# Normalize every text file to LF in the index regardless of the contributor's core.autocrlf;
# working-tree line endings stay per-platform (see .editorconfig for what editors write).
* text=auto

# Files consumed inside Linux containers or by POSIX tools must stay LF on every checkout
# (CRLF breaks bash, make and python shebangs).
Makefile text eol=lf
Dockerfile* text eol=lf
*.sh text eol=lf
*.py text eol=lf
# C3: hashed certifier inputs stay LF so content hashes do not flip with autocrlf.
tests/adversarial-corpus/** text eol=lf
ci/certifier-boundary-inventory.tsv text eol=lf
ci/published-version text eol=lf
ci/nupkg-layout.tsv text eol=lf
.devcontainer/post-create.sh text eol=lf
scripts/start-ashlar-api-dev.sh text eol=lf
scripts/stop-ashlar-api-dev.sh text eol=lf

# The certified sample bricks: the tracked certification-record.json binds a SHA-256 over the exact
# bytes of the brick source, so it must be LF on every checkout, not per-platform.
samples/certified-brick-reuse/Ashlar.Certified.DamageResolver/*.cs text eol=lf
samples/hello-brick/HelloBrick/*.cs text eol=lf
