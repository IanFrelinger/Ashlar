# Ashlar.API operator exposure (does not configure firewalls / Tailscale ACLs / reverse proxies — do that separately).
# Merge into your environment or pass: docker compose --env-file ...
#
# ExposureProfile: Localhost | Lan | Tailnet | Public (case-insensitive)
# FAIL-CLOSED: Lan / Tailnet / Public refuse to START while AuthorizationMode=None (and the legacy flag is off).
# Configure one of the auth blocks below, or set the escape hatch ONLY when an authenticating proxy /
# network ACL fronts Ashlar.API:
# Ashlar__Security__AllowUnauthenticatedNetworkExposure=true
Ashlar__Security__ExposureProfile=Tailnet

# Optional built-in API key auth for mutating endpoints:
# - enforced on POST/PUT/PATCH/DELETE under /api/*
# - advisory/status/capabilities GET routes remain open
# - set true to enforce and provide key via X-Ashlar-Api-Key header
# - fails closed: true with no ApiKey rejects every mutating request (401)
# Ashlar__Security__RequireApiKeyForMutatingEndpoints=true
# Ashlar__Security__ApiKey=replace-with-strong-secret
# Ashlar__Security__ApiKeyHeaderName=X-Ashlar-Api-Key
# Ashlar__Security__ExcludedApiKeyPaths=/api/director/run,/api/orchestrate

# Optional generalized built-in authorization layers:
# - AuthorizationMode: None | ApiKey | BearerToken | Basic | ApiKeyOrBearerToken | ApiKeyOrBasic | BearerTokenOrBasic | Any
# - AuthorizationScope: MutatingApi | AllApi
# - If AuthorizationMode != None, it takes precedence over RequireApiKeyForMutatingEndpoints
# Ashlar__Security__AuthorizationMode=ApiKeyOrBearerToken
# Ashlar__Security__AuthorizationScope=MutatingApi
# Ashlar__Security__ExcludedAuthorizationPaths=/api/security/advisory,/api/status
#
# API key mode uses:
# Ashlar__Security__ApiKey=replace-with-strong-secret
# Ashlar__Security__ApiKeyHeaderName=X-Ashlar-Api-Key
#
# Bearer token mode uses:
# Ashlar__Security__BearerToken=replace-with-strong-token
# Ashlar__Security__BearerTokenHeaderName=Authorization
# Ashlar__Security__BearerTokenScheme=Bearer
#
# Basic auth mode uses:
# Ashlar__Security__BasicAuthUsername=ashlar
# Ashlar__Security__BasicAuthPassword=replace-with-strong-password
# Ashlar__Security__BasicAuthHeaderName=Authorization

# Optional extra line in the Director portal advisory banner
# Ashlar__Security__CustomAdvisory=Use tag:ashlar; no shared accounts.

# Set false to hide the portal banner (GET /api/security/advisory still works)
# Ashlar__Security__ShowAdvisoryInPortal=true

# Remote container execution surface (POST /api/execution/build|run for RemoteExecutionPlatform):
# dark by default; requires an AuthorizationMode above (403 otherwise). Every nonempty VolumeMounts
# is rejected (400), including paths under the legacy AllowedVolumeMountRoot setting.
# Omit mounts for remote runs; use a trusted local execution workflow when mounts are required.
# Ashlar__Execution__ServeRemoteExecution=true
# AllowedVolumeMountRoot is retained for compatibility only and cannot enable remote mounts.
