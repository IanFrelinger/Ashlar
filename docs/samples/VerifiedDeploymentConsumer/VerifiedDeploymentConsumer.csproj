<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The runner copies this project outside the repository. Never add a ProjectReference. -->
    <PackageReference Include="Ashlar.Hosting.Bundle" Version="$(AshlarPackageVersion)" />
    <!-- Match third-party dependency floors used by the existing packaged host sample. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Propagators" Version="1.15.3" />
  </ItemGroup>
  <Target Name="RequirePackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(AshlarPackageVersion)' == ''" Text="Pass -p:AshlarPackageVersion with the exact version from the test feed." />
  </Target>
</Project>
