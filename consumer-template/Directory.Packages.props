<Project>
  <!-- Copy into your solution root as Directory.Packages.props (central package management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Must match a published Ashlar release (repo root VERSION when consuming from your fork). -->
    <AshlarConsumerPackageVersion>0.2.0</AshlarConsumerPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Ashlar.Brick.Contracts" Version="$(AshlarConsumerPackageVersion)" />
    <PackageVersion Include="Ashlar.Authoring" Version="$(AshlarConsumerPackageVersion)" />
    <PackageVersion Include="Ashlar.Hosting.Bundle" Version="$(AshlarConsumerPackageVersion)" />
    <PackageVersion Include="Ashlar.Sdk" Version="$(AshlarConsumerPackageVersion)" />
    <PackageVersion Include="Ashlar.Client" Version="$(AshlarConsumerPackageVersion)" />
  </ItemGroup>
</Project>
