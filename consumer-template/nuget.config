<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Optional private staging feed: uncomment only after replacing YOUR_ORG.
    <add key="ashlar-staging" value="https://nuget.pkg.github.com/YOUR_ORG/index.json" protocolVersion="3" />
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
  Private feed auth (uncomment and substitute; never commit real tokens):
  <packageSourceCredentials>
    <ashlar-staging>
      <add key="Username" value="YOUR_GITHUB_USERNAME_OR_token" />
      <add key="ClearTextPassword" value="YOUR_READ_OR_WRITE_PAT" />
    </ashlar-staging>
  </packageSourceCredentials>
  -->
</configuration>
