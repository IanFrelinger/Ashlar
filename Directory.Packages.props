<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Microsoft Extensions -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
    <PackageVersion Include="OsmSharp" Version="6.2.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Testcontainers.DynamoDb" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.Neo4j" Version="4.11.0" />
    <!-- Override transitive SSH.NET 2025.1.0 pulled by Testcontainers (NU1903 / GHSA-q939-rpr3-3284).
         SDK 10 audits transitive packages by default, so the two Testcontainers consumers reference
         the patched version directly (same pattern as SQLitePCLRaw below). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Neo4j.Driver" Version="5.28.1" />
  </ItemGroup>
  <!-- System Packages -->
  <ItemGroup>
    <PackageVersion Include="System.Text.Encodings.Web" Version="10.0.11" />
    <!-- Override transitive 4.3.0 (NU1903 / GHSA-cmhx-cq75-c4mj). -->
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <PackageVersion Include="System.Xml.XmlDocument" Version="4.3.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="System.Reactive" Version="6.0.1" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageVersion Include="System.Diagnostics.Process" Version="4.3.0" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>
  <!-- Code Analysis -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
  </ItemGroup>
  <!-- Assembly Analysis and Decompilation -->
  <ItemGroup>
    <PackageVersion Include="ICSharpCode.Decompiler" Version="8.0.0.7345" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.5" />
    <PackageVersion Include="System.Reflection.Metadata" Version="8.0.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
    <PackageVersion Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageVersion Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>
  <!-- Third-party Libraries -->
  <ItemGroup>
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.0" />
    <PackageVersion Include="LlamaSharp" Version="0.25.0" />
    <PackageVersion Include="LLamaSharp.Backend.Cpu" Version="0.25.0" />
    <!-- MEAI >= 10.8.3 is required by ModelContextProtocol 2.x (MCP protocol adapters);
         kept at the latest stable of the 10.x line, family-aligned across AI/VectorData. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.7.17" />
    <PackageVersion Include="Spectre.Console" Version="0.48.0" />
    <PackageVersion Include="YamlDotNet" Version="13.7.1" />
    <PackageVersion Include="CsvHelper" Version="30.0.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="JsonSchema.Net" Version="4.0.0" />
    <PackageVersion Include="CycloneDX" Version="5.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.10" />
    <PackageVersion Include="SkiaSharp" Version="2.88.6" />
    <PackageVersion Include="NAudio" Version="2.2.1" />
    <PackageVersion Include="System.Memory" Version="4.5.5" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Threading.Channels" Version="8.0.0" />
    <PackageVersion Include="System.Runtime.Loader" Version="4.3.0" />
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="11.12.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageVersion Include="Polly" Version="8.4.2" />
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="QuestPDF" Version="2024.12.1" />
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <PackageVersion Include="NetTopologySuite.IO.VectorTiles" Version="1.1.0" />
    <PackageVersion Include="NetTopologySuite.IO.VectorTiles.Mapbox" Version="1.1.0" />
    <PackageVersion Include="NetTopologySuite.IO.ShapeFile" Version="2.1.0" />
  </ItemGroup>
  <!-- Web/API Packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="7.4.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="7.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <!-- Azure Packages -->
  <ItemGroup>
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.20.0" />
    <PackageVersion Include="Azure.Storage.Common" Version="12.20.0" />
    <PackageVersion Include="Azure.ResourceManager.Storage" Version="1.2.0" />
    <PackageVersion Include="Azure.ResourceManager.ContainerService" Version="1.2.0" />
    <PackageVersion Include="Azure.ResourceManager.AppService" Version="1.2.0" />
    <PackageVersion Include="Azure.ResourceManager.Resources" Version="1.11.0" />
    <PackageVersion Include="Azure.Core" Version="1.46.2" />
  </ItemGroup>
  <!-- AWS Packages -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101" />
    <PackageVersion Include="AWSSDK.Lambda" Version="4.0.103" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.103.5" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.100.4" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.101.4" />
    <PackageVersion Include="AWSSDK.Extensions.Bedrock.MEAI" Version="4.0.101.8" />
  </ItemGroup>
  <!-- Entity Framework Packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- Override transitive SQLitePCLRaw.lib.e_sqlite3 2.1.6 (NU1903 / GHSA-2m69-gcr7-jv3q / CVE-2025-6965).
         The 2.1.x line has no fix; bundle 3.0.3 ships patched SQLite 3.50.4 via SourceGear.sqlite3.
         Referenced only by the two SQLite-consuming projects (native bundle, not applied solution-wide). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <PackageVersion Include="Npgsql" Version="8.0.6" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.1.5" />
    <PackageVersion Include="MongoDB.Driver" Version="2.24.0" />
  </ItemGroup>
  <!-- ASP.NET Core Packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Cors" Version="2.2.0" />
  </ItemGroup>
  <!-- Testing Packages -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
  </ItemGroup>
  <!-- Avalonia Packages -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.0.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="12.0.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  <!-- OpenTelemetry Packages (>=1.15.3: NU1902 / GHSA-g94r-2vxg-569j) -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <!-- Instrumentation packages version independently of the SDK; these are the latest that pin
         OpenTelemetry.Api.ProviderBuilderExtensions [1.15.3, 2.0.0), matching the 1.15.3 SDK above. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.3" />
  </ItemGroup>
  <!-- Code Analysis -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>
  <!-- SourceLink -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>
  <!-- Universal Tester Packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageVersion Include="JeremyAnsel.Media.WavefrontObj" Version="2.0.6" />
  </ItemGroup>
  <!-- Docker Packages -->
  <ItemGroup>
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
  </ItemGroup>
  <!-- gRPC Packages -->
  <ItemGroup>
    <PackageVersion Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.34.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.78.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
  </ItemGroup>
  <!-- Background Agents Packages -->
  <ItemGroup>
    <PackageVersion Include="NCrontab" Version="3.3.3" />
  </ItemGroup>
  <!-- Physical-atom certification (Phase 0) -->
  <ItemGroup>
    <PackageVersion Include="NSec.Cryptography" Version="25.4.0" />
    <PackageVersion Include="pocketken.H3" Version="4.0.0" />
  </ItemGroup>
  <!-- MCP / A2A protocol adapters (Tier-2 adapter projects and hosts only; the kernel
       spine — Ashlar.Abstractions / Ashlar.Core.* / Ashlar.Contracts / Ashlar.Hosting — must
       never reference these packages, or every AddAshlar consumer inherits them. -->
  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- A2A has no stable release yet (spec v1.0 is implemented by 1.0.0-preview2).
         Consuming projects are IsPackable=false until A2A 1.0.0 stable ships - packing a
         stable Ashlar version over a prerelease dependency raises NU5104. Do not NoWarn it. -->
    <PackageVersion Include="A2A" Version="1.0.0-preview2" />
    <PackageVersion Include="A2A.AspNetCore" Version="1.0.0-preview2" />
  </ItemGroup>
</Project>