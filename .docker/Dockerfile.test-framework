# Dockerfile for running Ashlar framework tests on Ubuntu (SDK 10 restores the net8 test graph;
# the 8.0 runtime below keeps the -f net8.0 lane on the real 8.0 runtime)
ARG DOTNET_SDK_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION}

RUN apt-get update && \
    apt-get install -y curl git && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --runtime dotnet --version 8.0.33 --install-dir /usr/share/dotnet && \
    bash /tmp/dotnet-install.sh --runtime aspnetcore --version 8.0.33 --install-dir /usr/share/dotnet && \
    rm -f /tmp/dotnet-install.sh

WORKDIR /workspace

COPY *.sln *.props global.json Directory.Build.props Directory.Packages.props ./
COPY src/ ./src/
COPY application/ ./application/
COPY coverage.runsettings ./

# Framework gate runs Infrastructure tests only (net8.0)
RUN dotnet restore src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj /p:TargetFramework=net8.0
RUN dotnet build src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj /p:TargetFramework=net8.0 --no-restore

CMD ["bash", "-c", "dotnet test src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj -f net8.0 --no-build --logger console;verbosity=minimal"]
