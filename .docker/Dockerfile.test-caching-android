# Dockerfile for running multi-platform tests on Android
ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# Install Android SDK and dependencies
RUN apt-get update && \
    apt-get install -y \
        curl \
        git \
        python3 \
        python3-pip \
        wget \
        unzip \
        openjdk-17-jdk \
        && rm -rf /var/lib/apt/lists/*

# Set up Android environment variables
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=${PATH}:${ANDROID_HOME}/tools:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/cmdline-tools/latest/bin

# Install Android SDK command line tools
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip && \
    unzip -q commandlinetools-linux-9477386_latest.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm commandlinetools-linux-9477386_latest.zip

# Accept Android licenses and install platform tools
RUN yes | sdkmanager --licenses || true && \
    sdkmanager "platform-tools" "platforms;android-33" "build-tools;33.0.0" || true

# Set working directory
WORKDIR /workspace

# Skip CopyAssemblies tool in container
ENV DOTNET_RUNNING_IN_CONTAINER=true

# Copy project files
COPY . .

# Install the .NET 8.0 runtime so the net8.0 inner build of the multi-target test projects
# runs on the real 8.0 runtime (net8 consumer story); the SDK image itself is 10.x.
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --version 8.0.33 --runtime aspnetcore --install-dir /usr/share/dotnet --no-path && \
    bash /tmp/dotnet-install.sh --version 8.0.33 --runtime dotnet --install-dir /usr/share/dotnet --no-path && \
    rm /tmp/dotnet-install.sh

# Restore dependencies for test projects
RUN dotnet restore src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj && \
    dotnet restore src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj

# Build test projects
RUN dotnet build src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj --no-restore && \
    dotnet build src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj --no-restore

# Default command: run base framework smoke tests
CMD ["bash", "-c", "dotnet test src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj --filter '(FullyQualifiedName~BaseFrameworkSmokeTests|FullyQualifiedName~RuntimeStudioBlackBoxSmokeTests)' --logger 'console;verbosity=normal' && dotnet test src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj --filter 'FullyQualifiedName~RuntimeStudioWhiteBoxSmokeTests' --logger 'console;verbosity=normal'"]
