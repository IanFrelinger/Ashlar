# Dev/test image: the devcontainer base, plus the runtime this repo's net8.0 targets need.
#
# WHY THIS EXISTS. mcr.microsoft.com/devcontainers/dotnet:10.0-noble ships ONLY the .NET 10
# runtimes, but this repo multi-targets net8.0. The container scripts used to compensate with
# DOTNET_ROLL_FORWARD=LatestMajor, which is not equivalent to installing 8.0: LatestMajor rolls
# net8.0 onto ASP.NET Core 10 *even when the 8.0 runtime is present*, and ASP.NET Core 8's
# ResponseBodyPipeWriter predates PipeWriter.UnflushedBytes, which System.Text.Json 10 requires.
# Every HTTP-hosting test then fails with an exception that reads exactly like a product bug.
#
# Measured on the GameDirector net8.0 suite in this image, with 8.0.30 installed:
#   DOTNET_ROLL_FORWARD=LatestMajor -> 10 failed
#   unset                           -> 167 passed
#
# CI does the right thing already (actions/setup-dotnet installs 10.0.x AND 8.0.x); this image is
# how the container scripts reach the same state. Build it with scripts/ensure-devtest-image.sh.
#
# WHERE THE 8.0 RUNTIME COMES FROM. Microsoft's own ASP.NET Core 8 runtime image, by a multi-stage
# COPY of its two shared frameworks (Microsoft.NETCore.App and Microsoft.AspNetCore.App). This used
# to run dot.net/v1/dotnet-install.sh, which downloads from builds.dotnet.microsoft.com; an
# environment that can pull from mcr.microsoft.com but not reach that host (a Claude Code cloud
# session's egress policy is one) could not build the image at all. Pulling the image needs only the
# registry, which the base image needs anyway. The -noble tag is the same Ubuntu 24.04 as the base,
# so the runtime's native dependencies (ICU, OpenSSL) are the OS versions Microsoft ships it on, and
# both tags are multi-arch, so an arm64 host gets arm64 bits from both stages. The end state is
# SDK 10, the real 8.0 runtime, jq, and Python's full standard library. host/fxr is not copied: the dotnet muxer always
# loads the newest hostfxr, which is the SDK's 10.x, and that resolves net8.0 apps onto the 8.0
# frameworks copied here.
#
# Nothing environment-specific is baked in: no CA certificate, no proxy. A build or run behind a
# proxy passes those in at the call (build args, -e, a read-only mount); see
# .claude/hooks/session-start.sh for the cloud-session form.
FROM mcr.microsoft.com/dotnet/aspnet:8.0-noble AS aspnet8

FROM mcr.microsoft.com/devcontainers/dotnet:10.0-noble

# A directory COPY copies the directory's CONTENTS, so each framework names its own destination;
# the 8.0.x version folder lands beside the base image's 10.0.x one.
COPY --from=aspnet8 /usr/share/dotnet/shared/Microsoft.NETCore.App/ /usr/share/dotnet/shared/Microsoft.NETCore.App/
COPY --from=aspnet8 /usr/share/dotnet/shared/Microsoft.AspNetCore.App/ /usr/share/dotnet/shared/Microsoft.AspNetCore.App/

RUN dotnet --list-runtimes \
 && dotnet --list-runtimes | grep -q '^Microsoft\.NETCore\.App 8\.' \
 && dotnet --list-runtimes | grep -q '^Microsoft\.AspNetCore\.App 8\.'

# jq asserts on scenario JSON. The base carries only python3-minimal; the full
# standard library is needed for JSON manifests, TRX parsing and evidence archives.
RUN apt-get update \
 && apt-get install -y --no-install-recommends jq python3 \
 && python3 -c 'import dataclasses, json, tarfile, xml.etree.ElementTree' \
 && rm -rf /var/lib/apt/lists/*

# DOTNET_ROLL_FORWARD is deliberately NOT set here. With 8.0 present, rolling forward is the
# behaviour this image exists to avoid.
ENV DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
