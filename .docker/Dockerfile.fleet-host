# Build stage follows global.json (SDK 10). The commercial Fleet.Host project targets net10.0, so the
# runtime stage is the 10.0 ASP.NET Core image.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore commercial/src/Ashlar.Commercial.Fleet.Host/Ashlar.Commercial.Fleet.Host.csproj
RUN dotnet publish commercial/src/Ashlar.Commercial.Fleet.Host/Ashlar.Commercial.Fleet.Host.csproj -c Release -o /app/publish --no-restore -p:ErrorOnDuplicatePublishOutputFiles=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./

# Runtime state (LiteDB stores, snapshots) and dailies live under /data so they survive container
# recreation when a volume is mounted there (docs/DEPLOYMENT.md, "Runtime state"). /app stays
# root-owned and read-only for the non-root user below.
ENV ASPNETCORE_URLS=http://+:8080 \
    ASHLAR_STATE_DIR=/data/state \
    ASHLAR_DAILIES_PATH=/data/dailies
RUN mkdir -p /data/state /data/dailies && chown -R app:app /data
EXPOSE 8080

# The aspnet image has no curl; probe /health with bash's /dev/tcp so the check can actually pass.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /health HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3 && grep -q " 200 " <&3' || exit 1

# Non-root: the aspnet 8+ images ship an unprivileged 'app' user (numeric $APP_UID so k8s runAsNonRoot can verify it).
USER $APP_UID

ENTRYPOINT ["dotnet", "Fleet.Host.dll"]
