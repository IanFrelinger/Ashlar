# Dockerfile for running multi-platform tests on Debian
ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# Install dependencies
RUN apt-get update && \
    apt-get install -y \
        curl \
        git \
        python3 \
        python3-pip \
        && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Skip CopyAssemblies tool in container
ENV DOTNET_RUNNING_IN_CONTAINER=true

# Copy project files
COPY . .

# Install the .NET 8.0 runtime so the net8.0 inner build of the multi-target test projects
# runs on the real 8.0 runtime (net8 consumer story); the CLI itself is net10.0 on the SDK image.
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --version 8.0.33 --runtime aspnetcore --install-dir /usr/share/dotnet --no-path && \
    bash /tmp/dotnet-install.sh --version 8.0.33 --runtime dotnet --install-dir /usr/share/dotnet --no-path && \
    rm /tmp/dotnet-install.sh

# Restore dependencies for test projects and CLI
RUN dotnet restore src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj && \
    dotnet restore src/Ashlar.Tests.Infrastructure/scripts/copy-assemblies.csproj && \
    dotnet restore src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj && \
    dotnet restore application/src/Ashlar.CLI/Ashlar.CLI.csproj

# Build test projects for net10.0 and CLI (net10.0)
RUN dotnet build src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj -f net10.0 --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj -f net10.0 --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build application/src/Ashlar.CLI/Ashlar.CLI.csproj --no-restore -v minimal

# Default command: run base framework and Trust tests
CMD ["bash", "-c", "dotnet test src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj --filter '(FullyQualifiedName~BaseFrameworkSmokeTests|FullyQualifiedName~RuntimeStudioBlackBoxSmokeTests)' --logger 'console;verbosity=normal' && dotnet test src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj --filter 'FullyQualifiedName~RuntimeStudioWhiteBoxSmokeTests' --logger 'console;verbosity=normal' && dotnet test src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~Trust' --logger 'console;verbosity=normal' && dotnet test src/Ashlar.Tests.BackgroundAgents/Ashlar.Tests.BackgroundAgents.csproj --filter 'FullyQualifiedName~Trust' --logger 'console;verbosity=normal'"]
